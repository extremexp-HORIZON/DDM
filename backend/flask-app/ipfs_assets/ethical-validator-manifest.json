{
  "name": "xxp-ddm-ethical-validator",
  "description": "LLM-based ethical / privacy / fairness assessment of tabular datasets.",
  "version": "1.0.0",
  "validator_type": "ethical_assessment",
  "implementation": {
    "stack": "python",
    "framework": "custom_llm_pipeline",
    "service": "ddm-backend-ethics"
  },
  "contact": {
